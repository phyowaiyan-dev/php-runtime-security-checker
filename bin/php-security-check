#!/usr/bin/env bash
set -uo pipefail
if ((BASH_VERSINFO[0]<4 || (BASH_VERSINFO[0]==4 && BASH_VERSINFO[1]<4))); then
    printf 'Bash 4.4+ is required.\n' >&2; exit 3
fi
export LC_ALL=C
BASE=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=../lib/common.sh
source "$BASE/lib/common.sh"
for module in detect advisories audit report services repository update; do
    # shellcheck source=/dev/null
    source "$BASE/lib/$module.sh"
done
mode=guided; no_color=0; chosen=0
usage() {
    printf '%s\n' 'Usage: bash bin/php-security-check' \
        'Check PHP, review a repair scope, confirm with 1/0, then patch and check again.' \
        'Optional: --check (read-only), --fix (guided repair), --no-color, --help, --version.' \
        'Exit: 0 package PASS, 1 FAIL, 2 UNKNOWN, 3 ERROR. No JSON/export modes.'
}
while (($#)); do
    case $1 in
        --check|--fix)
            ((chosen==0)) || { usage >&2; exit 3; }; chosen=1
            if [[ $1 == --check ]]; then mode=check; else mode=guided; fi;;
        --no-color) no_color=1;;
        --help) usage; exit 0;; --version) printf '%s\n' "$VERSION"; exit 0;;
        *) printf 'Unsupported option: %s\n' "$1" >&2; usage >&2; exit 3;;
    esac
    shift
done
ui_init
workflow
status_code
exit $?
